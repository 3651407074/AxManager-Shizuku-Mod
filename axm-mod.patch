+    /**
+     * Runs the starter through Shizuku, which executes it as shell (uid 2000) without needing
+     * root — the same thing "start as shell" does through su on a rooted device.
+     *
+     * Returns null when Shizuku isn't usable at all (not installed, not running), so the caller
+     * falls back to the root path; ACTIVATE_FAILED when Shizuku is there but refused or failed.
+     */
+    private suspend fun startAsShellViaShizuku(): Int? {
+        if (!Shizuku.pingBinder()) {
+            ActivationLog.warn("Shizuku isn't running — falling back to root")
+            return null
+        }
+
+        if (Shizuku.isPreV11() ||
+            Shizuku.checkSelfPermission() != PackageManager.PERMISSION_GRANTED
+        ) {
+            ActivationLog.info("Requesting Shizuku permission…")
+            if (!requestShizukuPermission()) {
+                ActivationLog.error("Shizuku permission wasn't granted")
+                return ACTIVATE_FAILED
+            }
+        }
+        ActivationLog.success("Shizuku permission granted")
+        ActivationLog.info("Running the starter as shell through Shizuku…")
+
+        return try {
+            // Shizuku's public API has no newProcess(); its service interface does, and the
+            // binder wrapper makes Shizuku's wrapper in the app talk to the real service.
+            val service = IShizukuService.Stub.asInterface(
+                ShizukuBinderWrapper(Shizuku.getBinder()!!)
+            )
+            val remote = service.newProcess(
+                arrayOf("sh", "-c", Starter.internalCommand), null, null
+            )
+            coroutineScope {
+                val out = launch(Dispatchers.IO) {
+                    pump(ParcelFileDescriptor.AutoCloseInputStream(remote.inputStream))
+                }
+                val err = launch(Dispatchers.IO) {
+                    pump(ParcelFileDescriptor.AutoCloseInputStream(remote.errorStream))
+                }
+                val code = withContext(Dispatchers.IO) { remote.waitFor() }
+                out.join()
+                err.join()
+                if (code == 0) {
+                    ActivationLog.success("Starter finished")
+                    ACTIVATE_SUCCESS
+                } else {
+                    ActivationLog.error("Starter exited with code $code")
+                    ACTIVATE_FAILED
+                }
+            }
+        } catch (e: Throwable) {
+            ActivationLog.error("Shizuku activation failed", e)
+            ACTIVATE_FAILED
+        }
+    }
+
+    /** Copies a remote stream into the activation log, line by line. */
+    private fun pump(stream: java.io.InputStream) {
+        runCatching {
+            stream.bufferedReader().use { reader ->
+                reader.forEachLine { line -> ActivationLog.output(line) }
+            }
+        }
+    }
+
+    /**
+     * Asks Shizuku for its permission and waits for the answer: the prompt is drawn by the
+     * Shizuku app, so this can't be a normal runtime-permission request.
+     */
+    private suspend fun requestShizukuPermission(): Boolean = try {
+        Shizuku.requestPermission(SHIZUKU_PERMISSION_REQUEST)
+        withTimeoutOrNull(60_000) {
+            while (Shizuku.checkSelfPermission() != PackageManager.PERMISSION_GRANTED) delay(300)
+            true
+        } ?: false
+    } catch (e: Throwable) {
+        ActivationLog.error("Shizuku permission request failed", e)
+        false
+    }
